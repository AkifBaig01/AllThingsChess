{
  "version": 3,

  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },

  "configurePresets": [
    {
      "name": "windows-debug",
      "displayName": "Windows Debug (MinGW)",
      "description": "Debug build using MinGW",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/../build-windows-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "YES"
      }
    },

    {
      "name": "windows-release",
      "displayName": "Windows Release (O3 - MinGW)",
      "description": "Release build with -O3 using MinGW",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/../build-windows-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "YES",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG"
      }
    },

    {
      "name": "windows-profile",
      "displayName": "Windows Profile (gprof - MinGW)",
      "description": "Profiling build using gprof",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/../build-windows-profile",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "YES",
        "CMAKE_CXX_FLAGS": "-O0 -pg -DNDEBUG",
        "CMAKE_EXE_LINKER_FLAGS": "-pg"
      }
    },

    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "description": "Debug build using Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build-linux-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "YES"
      }
    },

    {
      "name": "linux-release",
      "displayName": "Linux Release (O3)",
      "description": "Release build with -O3 using Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build-linux-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "YES",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG"
      }
    },

    {
      "name": "linux-profile",
      "displayName": "Linux Profile (O3 + Debug Symbols)",
      "description": "Optimised Linux build with debug symbols",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build-linux-profile",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "YES",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O3 -g -DNDEBUG"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "windows-debug",
      "displayName": "Build Windows Debug",
      "configurePreset": "windows-debug"
    },
    {
      "name": "windows-release",
      "displayName": "Build Windows Release",
      "configurePreset": "windows-release"
    },
    {
      "name": "windows-profile",
      "displayName": "Build Windows Profile",
      "configurePreset": "windows-profile"
    },
    {
      "name": "linux-debug",
      "displayName": "Build Linux Debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "displayName": "Build Linux Release",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-profile",
      "displayName": "Build Linux Profile",
      "configurePreset": "linux-profile"
    }
  ]
}